rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Rules for Users and their subcollections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // User's private subcollections (Only the owner can read/write)
      match /todos/{todoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /habits/{habitId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /countdowns/{countdownId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /sticky_notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /xp_history/{xpId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Friends & Friend Requests (Requires access by both sender/recipient for mutual sync)
      match /friends/{friendId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
      }
      match /incoming_requests/{requestId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == requestId);
      }
      match /sent_requests/{recipientId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == recipientId);
      }
    }

    // 2. Arena Sessions (Users need to post their session & peers need to send cheers)
    match /arena_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // 3. Chat Rooms & Messages
    match /chats/{chatRoomId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
